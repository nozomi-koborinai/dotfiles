# ===== WezTerm shell integration (OSC 133, what ScrollToPrompt reads) =====
if [[ "$TERM_PROGRAM" == "WezTerm" ]]; then
  precmd() { printf "\e]133;A\e\\" }
  preexec() { printf "\e]133;C\e\\" }
fi

# Prioritize Homebrew Dart SDK over Flutter SDK
export PATH="/opt/homebrew/bin:$PATH"

# dotfiles bin
export PATH="$HOME/dotfiles/bin:$PATH"

export PATH="$PATH:$HOME/Developer/flutter/bin"
export PATH="$PATH":"$HOME/.pub-cache/bin"
export PATH=$PATH:$(go env GOPATH)/bin
autoload -U +X compinit && compinit
autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C /opt/homebrew/bin/terraform terraform

# Node version manager. --use-on-cd picks up .nvmrc / .node-version per project.
# Guarded so a machine that has not run setup.sh yet still gets a working shell.
command -v fnm > /dev/null && eval "$(fnm env --use-on-cd --shell zsh)"

## [Completion]
## Completion scripts setup. Remove the following line to uninstall
[[ -f $HOME/.dart-cli-completion/zsh-config.zsh ]] && . $HOME/.dart-cli-completion/zsh-config.zsh || true
## [/Completion]

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"
export PATH="$HOME/.local/bin:$PATH"

# Google Cloud SDK
export PATH="/opt/homebrew/share/google-cloud-sdk/bin:$PATH"

# ===== zeno.zsh (abbreviation) =====
export ZENO_HOME="$HOME/.zeno"
if [[ -f "$ZENO_HOME/zeno.zsh" ]]; then
  source "$ZENO_HOME/zeno.zsh"
  bindkey ' ' zeno-auto-snippet
  bindkey '^m' zeno-auto-snippet-and-accept-line
  bindkey '^i' zeno-completion
fi

# ===== Git Worktree Helpers =====

# gwt <branch-name> → add a worktree at ../git-worktrees/<repo-name>-<branch-name>
function gwt() {
  GIT_ROOT=$(git rev-parse --show-toplevel)
  REPO_NAME=$(basename "$GIT_ROOT")
  git worktree add "../git-worktrees/${REPO_NAME}-$1" -b "$1"
}

# gwtclean → drop the worktrees whose branch has already been merged
function gwtclean() {
  local main_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
  : ${main_branch:=main}

  # Merged branches, with main and develop held back
  local merged_branches=$(git branch --merged "$main_branch" | grep -v '^\*' | grep -v -E '^\s*(main|develop)\s*$' | sed 's/^[[:space:]]*//')

  if [[ -z "$merged_branches" ]]; then
    echo "No merged branches found."
    return 0
  fi

  git worktree list | while read -r line; do
    local wt_path=$(echo "$line" | awk '{print $1}')
    local wt_branch=$(echo "$line" | grep -oE '\[.+\]' | tr -d '[]')

    if [[ -n "$wt_branch" ]] && echo "$merged_branches" | grep -qx "$wt_branch"; then
      echo "Removing merged worktree: $wt_path (branch: $wt_branch)"
      git worktree remove "$wt_path"
      git branch -d "$wt_branch"
    fi
  done

  echo "Cleanup complete."
}

# gsync → sync, clear out merged worktrees, then show what branches are left
function gsync() {
  git sync && gwtclean && git branch
}