#!/bin/bash

set -e

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

source "$DOTFILES_DIR/lib.sh"

case "${1:-}" in
  sync)
    echo "Syncing dotfiles..."
    cd "$DOTFILES_DIR"
    # Syncing right after editing a config is the normal case, so keep local
    # work in place instead of refusing to pull.
    git pull --rebase --autostash
    bash setup.sh
    echo ""
    echo "Done!"
    ;;
  update)
    echo "Updating tools..."

    # Homebrew
    if command -v brew &> /dev/null; then
      echo ""
      echo "==> Homebrew"
      brew update && brew upgrade && brew upgrade --greedy
    fi

    # gh extensions
    if command -v gh &> /dev/null; then
      echo ""
      echo "==> gh extensions"
      gh extension upgrade --all
    fi

    # zeno.zsh
    if [ -d "$HOME/.zeno" ]; then
      echo ""
      echo "==> zeno.zsh"
      git -C "$HOME/.zeno" pull
    fi

    # cursor-agent (setup.sh handles the first install)
    if command -v cursor-agent &> /dev/null; then
      echo ""
      echo "==> cursor-agent"
      curl https://cursor.com/install -fsSL | bash
    fi

    # vde-layout
    if command -v npm &> /dev/null; then
      echo ""
      echo "==> vde-layout"
      npm update -g vde-layout
    fi

    # nvim plugins
    if command -v nvim &> /dev/null; then
      echo ""
      echo "==> nvim plugins"
      nvim --headless "+Lazy! update" +qa &> /dev/null || true
      if git -C "$DOTFILES_DIR" diff --quiet -- configs/nvim/lazy-lock.json; then
        echo "  already pinned to the latest versions"
      else
        echo "  lazy-lock.json changed — commit it so other machines get the same versions"
      fi
    fi

    echo ""
    echo "Update complete!"
    ;;
  prune)
    echo "Removing packages this machine has but the Brewfile does not declare..."

    if command -v brew &> /dev/null; then
      trust_declared_taps
      brew bundle cleanup --file="$DOTFILES_DIR/Brewfile" --force
    fi

    sync_nvim_plugins

    echo ""
    echo "Done!"
    ;;
  *)
    echo "Usage: dotfiles <command>"
    echo ""
    echo "Commands:"
    echo "  sync      Pull latest and apply symlinks"
    echo "  update    Update all managed tools"
    echo "  prune     Uninstall packages not declared in the Brewfile"
    ;;
esac
