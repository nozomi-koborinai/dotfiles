#!/bin/bash

set -e

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

source "$DOTFILES_DIR/lib.sh"

case "${1:-}" in
  sync)
    echo "Syncing dotfiles..."
    cd "$DOTFILES_DIR"
    # Syncing right after editing a config is the normal case, so keep local
    # work in place instead of refusing to pull.
    git pull --rebase --autostash
    bash setup.sh
    echo ""
    echo "Done!"
    ;;
  update)
    echo "Updating tools..."

    # Homebrew
    if command -v brew &> /dev/null; then
      echo ""
      echo "==> Homebrew"
      brew update && brew upgrade && brew upgrade --greedy
    fi

    # gh extensions
    if command -v gh &> /dev/null; then
      echo ""
      echo "==> gh extensions"
      gh extension upgrade --all
    fi

    # zeno.zsh
    if [ -d "$HOME/.zeno" ]; then
      echo ""
      echo "==> zeno.zsh"
      git -C "$HOME/.zeno" pull
    fi

    # vde-layout
    if command -v npm &> /dev/null; then
      echo ""
      echo "==> vde-layout"
      npm update -g vde-layout
    fi

    # nvim plugins
    if command -v nvim &> /dev/null; then
      echo ""
      echo "==> nvim plugins"
      nvim --headless "+Lazy! update" +qa &> /dev/null || true
      if git -C "$DOTFILES_DIR" diff --quiet -- configs/nvim/lazy-lock.json; then
        echo "  already pinned to the latest versions"
      else
        echo "  lazy-lock.json changed — commit it so other machines get the same versions"
      fi
    fi

    echo ""
    echo "Update complete!"
    ;;
  prune)
    assume_yes=0
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        -y|--yes)
          assume_yes=1
          ;;
        *)
          echo "Usage: dotfiles prune [-y|--yes]" >&2
          exit 2
          ;;
      esac
      shift
    done

    plan_status=0
    plan=$(prune_plan) || plan_status=$?

    if [ "$plan_status" -ne 0 ] && [ -z "$plan" ]; then
      echo "Cannot tell what would be removed. Nothing was removed." >&2
      exit 1
    fi

    if [ -z "$plan" ] && [ "$plan_status" -eq 0 ]; then
      echo "Nothing to remove."
      exit 0
    fi

    echo ""
    prune_plan_print "$plan"
    if plan_has "$plan" nvim; then
      echo "Agreeing also restores plugins to the versions in lazy-lock.json."
    fi

    if [ "$assume_yes" -eq 1 ]; then
      echo "Removing without asking (--yes)."
    elif [ -t 0 ]; then
      answer=""
      read -r -p "Proceed? [y/N] " answer || answer=""
      case "$answer" in
        y|Y|yes) ;;
        *)
          echo "Aborted. Nothing was removed." >&2
          exit 1
          ;;
      esac
    else
      echo "Aborted: stdin is not a terminal, so prune cannot ask. Re-run with --yes to remove without asking." >&2
      exit 1
    fi

    prune_apply "$plan"
    echo ""
    echo "Done!"
    ;;
  *)
    echo "Usage: dotfiles <command>"
    echo ""
    echo "Commands:"
    echo "  sync      Pull latest and apply symlinks"
    echo "  update    Update all managed tools"
    echo "  prune     List removals and uninstall after confirmation (-y/--yes skips the question)"
    ;;
esac
